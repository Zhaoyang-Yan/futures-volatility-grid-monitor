[Unit]
Description=grid_monitor Flask Dashboard and monitor worker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/grid_monitor
# Ubuntu images usually use "ubuntu"; Oracle Linux images may use "opc".
User=ubuntu
EnvironmentFile=/opt/grid_monitor/.env
ExecStart=/opt/grid_monitor/.venv/bin/gunicorn -c gunicorn.conf.py main:app
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
